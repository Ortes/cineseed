# Cineseed backend configuration.
# Copy to `.env` (kept out of git) and fill in. NEVER commit real secret values.

# Torznab tracker. Works with Prowlarr, Jackett, or any tracker exposing a
# Torznab feed directly. BASEURL is the
# root under which /api?t=search lives, e.g.
#   Prowlarr:  http://localhost:9696/1  (per-indexer Torznab endpoint)
#   Jackett:   http://localhost:9117/api/v2.0/indexers/<indexer>/results/torznab
CINESEED_TRACKER_APIKEY=
CINESEED_TRACKER_BASEURL=

# Transmission RPC (reuses an existing daemon)
TRANSMISSION_URL=http://localhost:9091/transmission/rpc
TRANSMISSION_USER=
TRANSMISSION_PASS=

# OPTIONAL S3-compatible storage (AWS S3, Scaleway, MinIO, Backblaze B2, …).
# Leave all of these empty to keep films on the local disk and stream them from
# there. With S3, finished films are uploaded, then streamed via presigned URLs.
# Set all four of endpoint/bucket/keys, or none: a partial set refuses to boot.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Stream URL lifetime (seconds) and HTTP port
STREAM_URL_TTL=21600
PORT=8080

# --- deploy/docker-compose.yml (only read when deploying with it) ---------
# Public domain served by Caddy (deploy/Caddyfile reads {$CINESEED_DOMAIN}).
CINESEED_DOMAIN=cineseed.example.com
# Image to run; defaults to the latest release. Pin a build with e.g.
# ghcr.io/ortes/cineseed:1.2.3 or :sha-<commit> (deploy.sh pins it for you).
CINESEED_IMAGE=
# Host dir for downloads + Transmission's config (default: deploy/data).
CINESEED_DATA=
# User/group Transmission writes files as.
PUID=1000
PGID=1000

# Where Transmission puts finished / in-progress downloads, as the backend
# sees them (the compose file mounts both at the same path in both
# containers). These match the linuxserver/transmission defaults.
#
# With S3, DOWNLOAD_DIR is instead where Transmission is pointed once a torrent
# is uploaded — typically an rclone mount of the bucket, so it keeps seeding
# with no local copy — and Transmission must use incomplete-dir=INCOMPLETE_DIR
# on the local disk (the backend streams the in-progress file from there).
DOWNLOAD_DIR=/downloads/complete
INCOMPLETE_DIR=/downloads/incomplete

# TMDB v3 API key — enables /api/tmdb/movie/:id (poster, overview, …).
# Get one at https://www.themoviedb.org/settings/api. Leave empty to disable.
TMDB_API_KEY=

# Where the backend keeps its SQLite database (cineseed.db: the suggestions,
# rebuilt daily from C411 + TMDB). Unset => in memory only: every restart
# spends minutes rebuilding them. Point it at a mounted data volume.
CINESEED_DATA_DIR=/downloads/data

# Live HLS streaming (multi-audio + subtitles + Dolby→AAC). Segments are
# generated on demand from the presigned S3 URL — ffmpeg/ffprobe must be on PATH
# (or set absolute paths). HLS_MAX_TRANSCODES caps concurrent ffmpeg processes;
# the defaults are sized for a small 1 vCPU / 1 GB VPS. Audio that isn't
# already AAC (e.g. Dolby EAC3/AC3, DTS) is transcoded to AAC at
# HLS_AUDIO_BITRATE.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
HLS_SEGMENT_SECONDS=4
HLS_MAX_TRANSCODES=3
HLS_AUDIO_BITRATE=192k
# Where produced HLS segments are written. Unset => system temp, which in a
# container is the overlay filesystem on the root disk — point it at a
# mounted data volume with headroom instead.
HLS_PRODUCER_TEMP=/downloads/hls

# Latency optimization. Some S3 providers charge a fixed time-to-first-byte per
# range request (measured on Scaleway from a same-region server: 0.08-0.20 s),
# and ffmpeg re-reads the MKV header/index on every segment. That per-request
# cost, not throughput, is what sets the chunk size: a 32 MiB span took 1.09 s
# as 4x8 MiB but 3.21 s as 16x2 MiB — so keep HLS_PROXY_CHUNK_MB large. A
# loopback caching range proxy fronts S3: it fetches in aligned chunks over a
# kept-alive connection, reads ahead, and caches the invariant header/index so
# only new cluster bytes hit the network.
# HLS_PROXY_CHUNK_MB     upstream fetch granularity (bigger = fewer round-trips)
# HLS_PROXY_READAHEAD    chunks prefetched ahead of ffmpeg's read head
# HLS_PROXY_CACHE_MB     global proxy chunk-cache cap (keep modest on a 1 GB box)
# HLS_PROXY_MAX_SERVE_MB max bytes served per request (caps open-ended reads so
#                        one ffmpeg seek can't drag the whole file through)
HLS_PROXY_CHUNK_MB=8
HLS_PROXY_READAHEAD=3
# Chunk memory is pool-bounded to exactly this value (see S3RangeProxy), and it
# maps to process RSS roughly linearly: ~18 MB of RSS per 16 MiB of cap, since
# dart:io's HTTP buffers scale with it. 64 MiB holds one active title's working
# set (current chunk + read-ahead + MKV header + Cues); 32 MiB frees ~36 MB at
# the cost of an occasional ~0.15 s refetch. Oversizing this on a swapless
# 1 GB box froze the process in kernel direct-reclaim (verified via PSI).
HLS_PROXY_CACHE_MB=64
HLS_PROXY_MAX_SERVE_MB=16
# HLS_PROXY_MAX_CONCURRENT concurrent proxy responses; excess requests QUEUE
#                        (never rejected — ffmpeg runs without
#                        -reconnect_on_http_error, so a 503 at connection-open
#                        would kill the producer rather than retry). Bounds how
#                        many chunks live responses can pin references to.
HLS_PROXY_MAX_CONCURRENT=6

# How long an HLS session may sit unused before it is evicted — killing its
# ffmpeg producer and dropping its cached proxy chunks. Deliberately NOT
# STREAM_URL_TTL: that is the presigned-URL lifetime (6 h), and sharing it kept
# a finished session's producer and cache alive long after anyone stopped
# watching. A periodic sweep applies this even with no incoming requests.
HLS_SESSION_IDLE_TTL=600

# Verbose debug mode. When true: the backend logs the full ffmpeg / producer /
# session lifecycle (and runs ffmpeg at -loglevel verbose with live stderr) and
# KEEPS every HLS segment file on disk for post-mortem inspection (no cleanup —
# can grow to many GB; survives restarts). The frontend (which reads this via
# GET /api/config at startup) logs all API calls, player events and user
# actions, and the player logs hls.js fragment/stall/error events to the browser
# console. Toggle at runtime with NO rebuild: flip this in the server's .env and
# restart the container. (?debug=1 in the URL is a client-only override.)
CINESEED_DEBUG=false
