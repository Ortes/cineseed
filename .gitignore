# ─────────────────────────────────────────────────────────────
# Secrets / local config — NEVER COMMIT (repo is public)
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
# Personal ops files (kept in a separate private repo cloned at private/)
private/
CLAUDE.local.md
.claude/
deploy/deploy.env
# Host-specific compose layout (symlinked from private/) and default data dir
deploy/docker-compose.override.yml
deploy/data/
*.key
*.pem
*.p12
*.pfx
config/secrets*
**/secrets.dart
*.credentials

# ─────────────────────────────────────────────────────────────
# Dart / Flutter
# ─────────────────────────────────────────────────────────────
.dart_tool/
.packages
.pub-cache/
.pub/
build/
**/build/
.flutter-plugins
.flutter-plugins-dependencies
.flutter-versions
.last_build_id
doc/api/
coverage/
*.dart.js
*.info.json
*.symbols
app.*.map.json

# Generated code (project uses no codegen, but guard anyway)
**/*.g.dart
**/*.freezed.dart
**/*.mocks.dart

# ─────────────────────────────────────────────────────────────
# Compiled backend binary (built in Docker, shipped to server)
# ─────────────────────────────────────────────────────────────
/out/
cineseed-server
*.exe
*.aot
*.dill

# ─────────────────────────────────────────────────────────────
# Flutter web build copied into the backend (generated in CI)
# ─────────────────────────────────────────────────────────────
backend/public/*
!backend/public/.gitkeep

