# Deploy targets for deploy/deploy.sh.
# Copy to deploy/deploy.env (gitignored) and fill in your own values.

# SSH destination of the server running docker compose.
SERVER="user@your-server"

# Directory on the server where docker-compose.yml, Caddyfile and .env live.
REMOTE="/home/user/cineseed"

# Container registry image to build and push. You need push access
# (e.g. `docker login ghcr.io` with a write:packages PAT), and the server
# needs pull access if the image is private.
IMAGE="ghcr.io/you/cineseed"
